# Copy to .env and fill in. Leave keys empty to use the built-in fallback debugger.
AI_PROVIDER=auto            # auto | anthropic | openai | fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=                   # optional; defaults: claude-sonnet-5-5 / gpt-4o-mini
MAX_REPAIR_ATTEMPTS=3
EXEC_TIMEOUT=10
